stock OpenGate(gateid) {
    if (gateid == 1)
    {
        MoveDynamicObject(GateBOT[1], 36.8407, -1523.7463, 0.6000, b_GSPEED);
        SetTimerEx("CloseGate", b_CDOWN, false, "d", 1);
    }
    else if (gateid == 2)
    {
        MoveDynamicObject(GateBOT[0], 35.9096, -1536.0658, 0.6000, b_GSPEED);
        SetTimerEx("CloseGate", b_CDOWN, false, "d", 2);
    }
    else if (gateid == 3)
    {
        MoveDynamicObject(GateBOT[2], 1714.8131, 434.0721, 26.5000, b_GSPEED);
        SetTimerEx("CloseGate", b_CDOWN, false, "d", 3);
    }
    else if (gateid == 4)
    {
        MoveDynamicObject(GateBOT[3], 1701.5071, 438.6569, 26.5000, b_GSPEED);
        SetTimerEx("CloseGate", b_CDOWN, false, "d", 4);
    }
}

forward CloseGate(idgate);
public CloseGate(idgate) {
    if(idgate == 1)
        MoveDynamicObject(GateBOT[1], 36.8407, -1523.7463, 8.0000, b_GSPEED);
    else if(idgate == 2)
        MoveDynamicObject(GateBOT[0], 35.9096, -1536.0658, 8.0000, b_GSPEED);
    else if(idgate == 3)
        MoveDynamicObject(GateBOT[2], 1714.8131, 434.0721, 33.3000, b_GSPEED);
    else if(idgate == 4)
        MoveDynamicObject(GateBOT[3], 1701.5071, 438.6569, 33.3000, b_GSPEED);
    return 1;
}
